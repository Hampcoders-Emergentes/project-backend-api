<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <RollForward>LatestMajor</RollForward>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;tools/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <!-- Dependency Injection related packages -->
        <PackageReference Include="CloudinaryDotNet" Version="1.27.5" />
        <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="11.1.0" />
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.85">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.300">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- EntityFrameworkCore Database Persistence related packages -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Design" Version="1.1.6" />
        <PackageReference Include="NetTopologySuite" Version="2.6.0" />
        <!-- PostgreSQL Database Persistence related packages -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <!-- Audit Trails related packages -->
        <PackageReference Include="EntityFrameworkCore.CreatedUpdatedDate" Version="8.0.0" />
        <!-- Naming convention conversion related packages -->
        <PackageReference Include="Humanizer" Version="2.14.1" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
        <PackageReference Include="OpenAI" Version="2.2.0" />
        <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>        <!-- OpenAPI documentation related packages -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.20.0" />
        <!-- BCrypt Encription related packages -->
        <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
        <!-- JSON Web Token related packages -->
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
        <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.19.2" />
        <PackageReference Include="Stripe.net" Version="48.3.0" />
        <PackageReference Include="Cortex.Mediator" Version="1.6.1" />
        <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Analytics\Application\" />
      <Folder Include="Analytics\Domain\" />
      <Folder Include="Analytics\Infrastructure\" />
      <Folder Include="Analytics\Interfaces\" />
      <Folder Include="Assets\Application\Internal\OutboundServices\" />
      <Folder Include="docs\apis\" />
      <Folder Include="docs\output\" />
      <Folder Include="Planning\Application\" />
      <Folder Include="Planning\Domain\" />
        <Folder Include="Subscriptions\" />
        <Folder Include="tactical-docs\tactical\" />
        <Folder Include="Processing\Application\" />
        <Folder Include="Processing\Domain\" />
        <Folder Include="Processing\Infrastructure\" />
        <Folder Include="Processing\Interfaces\" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="Profiles\.DS_Store" />
    </ItemGroup>

    <ItemGroup>
      <None Update="**\Prompts\*.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
