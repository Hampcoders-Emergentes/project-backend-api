# Allowlists de dispositivos edge. Sin entradas, esos endpoints responden 403 (hay un aviso al arrancar).
# Usa claves indexadas (__0, __1, ...): un valor sin indice o separado por comas no se lee como lista.
# EdgeApi__EquipmentReadings__AllowedDeviceIds__0="CHANGE_ME"
# EdgeApi__RelayHistory__AllowedDeviceIds__0="CHANGE_ME"

# Opcional: cambia el proveedor activo.
# ExternalProviders__Payment="stripe"
# ExternalProviders__FileStorage="cloudinary"
# ExternalProviders__AIMatching="gemini"

# Opcional: credenciales MQTT.
# Mqtt__Username=""
# Mqtt__Password=""
