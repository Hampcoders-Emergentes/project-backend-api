# Plantilla de variables de entorno. No pongas secretos reales aquí.
# Uso local:
#   cp .env.example .env
#   # edita .env con tus valores
#   set -a; source .env; set +a
#   dotnet run --project Hampcoders.Electrolink.API.csproj

ConnectionStrings__DefaultConnection="Host=localhost;Port=5433;Username=postgres;Password=CHANGE_ME;Database=electrolink2"
TokenSettings__Secret="CHANGE_ME_USE_AT_LEAST_32_CHARACTERS"

